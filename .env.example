# OpenAI-compatible API (like Ollama, LM Studio, etc.)
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=llama3

# Redis
REDIS_URL=redis://localhost:6379

# Google Tag Manager
# Get your ID from https://tagmanager.google.com (format: GTM-XXXXXX)
GTAG_ID=

# Google AdSense
# Get your publisher ID from https://adsense.google.com (format: ca-pub-XXXXXXXXXXXXXXXX)
# Configure AdSense as a tag inside Google Tag Manager (GTM)
# Then add the account ID below for the meta tag verification
ADSENSE_ACCOUNT_ID=

# Cloudflare Turnstile (CAPTCHA alternative)
# Get your keys from https://dash.cloudflare.com/turnstile
# PUBLIC_ prefix exposes the site key to the client
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Allowed origins for CSRF protection (comma-separated, e.g. https://stroncami.it,https://www.stroncami.it)
# If empty, same-host requests are allowed (based on Host header)
ALLOWED_ORIGINS=

# Public base URL — used in sitemap and for absolute URL generation.
# Set this to the canonical domain to avoid localhost leaking in sitemap when behind a proxy.
PUBLIC_URL=https://stroncami.it

# Brevo (ex Sendinblue) newsletter integration
# Get your API key from https://app.brevo.com/settings/keys/api
# Required permissions: Newsletter and Contacts
BREVO_API_KEY=xkey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Brevo contact list ID to add subscribers to (found in Contacts → Lists)
BREVO_LIST_ID=