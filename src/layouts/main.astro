---
import "@/styles/global.css"
import { getLocaleFromURL, useTranslations, locales } from "@/i18n/utils"
import LanguageSwitcher from "@/components/LanguageSwitcher.astro"
import SEO from "@/components/SEO.astro"
import GoogleAnalytics from "@/components/GoogleAnalytics.astro"
import Footer from "@/components/Footer.astro"

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props
const locale = getLocaleFromURL(Astro.url, Astro.request)
const { t } = useTranslations(locale)

const currentPath = Astro.url.pathname
function getLocalizedPath(loc: string) {
  const parts = currentPath.split("/").filter(Boolean)
  if (locales.includes(parts[0] as any)) parts[0] = loc
  else parts.unshift(loc)
  return "/" + parts.join("/")
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO locale={locale} title={title} description={description} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.classList.add(theme);
        if (localStorage.getItem('fire-disabled') === 'true') {
          document.documentElement.classList.add('no-fire');
        }
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <div class="heat-distortion fire"></div>

    <!-- ── Desktop top-left nav ── -->
    <div class="hidden md:flex fixed top-4 left-4 z-50 items-center gap-2">
      <a href={`/${locale}/rankings`} class="px-2.5 py-1 text-xs rounded-md bg-zinc-900/90 text-orange-400/80 border border-orange-500/20 hover:border-orange-400/50 hover:text-orange-300 transition-colors backdrop-blur-sm">{t("rankings.navLink")}</a>
      <a href={`/${locale}/about`}    class="px-2.5 py-1 text-xs rounded-md bg-zinc-900/90 text-orange-400/80 border border-orange-500/20 hover:border-orange-400/50 hover:text-orange-300 transition-colors backdrop-blur-sm">{t("nav.about")}</a>
      <a href={`/${locale}/how-it-works`} class="px-2.5 py-1 text-xs rounded-md bg-zinc-900/90 text-orange-400/80 border border-orange-500/20 hover:border-orange-400/50 hover:text-orange-300 transition-colors backdrop-blur-sm">{t("nav.howItWorks")}</a>
    </div>

    <!-- ── Desktop top-right controls ── -->
    <div class="hidden md:flex fixed top-4 right-4 z-50 items-center gap-1.5">
      <button data-action="toggle-theme" aria-label="Toggle theme" class="p-1.5 rounded-md bg-zinc-900/90 border border-orange-500/20 hover:border-orange-400/50 text-orange-400/80 hover:text-orange-300 transition-colors backdrop-blur-sm text-sm leading-none">
        <span class="theme-icon">☀️</span>
      </button>
      <button data-action="toggle-fire" aria-label="Disable background animation" class="p-1.5 rounded-md bg-zinc-900/90 border border-orange-500/20 hover:border-orange-400/50 text-orange-400/80 hover:text-orange-300 transition-colors backdrop-blur-sm text-sm leading-none">
        <span class="fire-icon">🔥</span>
      </button>
      <LanguageSwitcher />
    </div>

    <!-- ── Mobile hamburger ── -->
    <div class="md:hidden fixed top-4 right-4 z-50">
      <button id="menu-open" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-sidebar" class="flex items-center justify-center w-9 h-9 rounded-md bg-zinc-900/90 border border-orange-500/20 text-orange-400/80 hover:border-orange-400/50 hover:text-orange-300 transition-colors backdrop-blur-sm">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- ── Mobile sidebar overlay ── -->
    <div id="sidebar-overlay" class="md:hidden fixed inset-0 z-40 bg-black/60 backdrop-blur-[2px] hidden" aria-hidden="true"></div>

    <!-- ── Mobile sidebar ── -->
    <aside
      id="mobile-sidebar"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
      class="md:hidden fixed top-0 right-0 bottom-0 z-50 w-64 flex flex-col bg-zinc-950/98 border-l border-orange-500/20 backdrop-blur-md shadow-2xl translate-x-full transition-transform duration-200 ease-out"
    >
      <!-- Header -->
      <div class="flex items-center justify-between px-4 pt-4 pb-3 border-b border-orange-500/10">
        <span class="text-xs font-semibold text-orange-400/60 uppercase tracking-widest">Menu</span>
        <button id="menu-close" aria-label="Close menu" class="flex items-center justify-center w-8 h-8 rounded-md text-orange-400/60 hover:text-orange-300 hover:bg-orange-500/10 transition-colors">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <!-- Nav links -->
      <nav class="flex flex-col gap-1 px-3 pt-3">
        <a href={`/${locale}/rankings`}    class="flex items-center gap-2.5 px-3 py-2.5 rounded-md text-sm text-orange-400/80 hover:text-orange-300 hover:bg-orange-500/8 transition-colors">{t("rankings.navLink")}</a>
        <a href={`/${locale}/about`}       class="flex items-center gap-2.5 px-3 py-2.5 rounded-md text-sm text-orange-400/80 hover:text-orange-300 hover:bg-orange-500/8 transition-colors">{t("nav.about")}</a>
        <a href={`/${locale}/how-it-works`} class="flex items-center gap-2.5 px-3 py-2.5 rounded-md text-sm text-orange-400/80 hover:text-orange-300 hover:bg-orange-500/8 transition-colors">{t("nav.howItWorks")}</a>
      </nav>

      <!-- Divider -->
      <div class="mx-3 my-3 border-t border-orange-500/10"></div>

      <!-- Theme + Fire toggles -->
      <div class="flex flex-col gap-1 px-3">
        <button data-action="toggle-theme" aria-label="Toggle theme" class="flex items-center justify-between px-3 py-2.5 rounded-md text-sm text-orange-400/80 hover:text-orange-300 hover:bg-orange-500/8 transition-colors w-full text-left">
          <span class="theme-label">Theme</span>
          <span class="theme-icon text-base">☀️</span>
        </button>
        <button data-action="toggle-fire" aria-label="Disable background animation" class="flex items-center justify-between px-3 py-2.5 rounded-md text-sm text-orange-400/80 hover:text-orange-300 hover:bg-orange-500/8 transition-colors w-full text-left">
          <span>Animation</span>
          <span class="fire-icon text-base">🔥</span>
        </button>
      </div>

      <!-- Divider -->
      <div class="mx-3 my-3 border-t border-orange-500/10"></div>

      <!-- Language grid -->
      <div class="px-3">
        <p class="text-xs text-orange-400/40 uppercase tracking-widest mb-2 px-1">Language</p>
        <div class="grid grid-cols-3 gap-1">
          {locales.map((loc) => (
            <a
              href={getLocalizedPath(loc)}
              aria-label={`Switch to ${loc.toUpperCase()}`}
              class={`flex items-center justify-center py-2 rounded-md text-xs font-medium transition-colors ${
                locale === loc
                  ? "bg-orange-500/15 text-orange-400 border border-orange-500/30"
                  : "text-zinc-400 hover:text-orange-300 hover:bg-zinc-800/80 border border-transparent"
              }`}
            >
              {loc.toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </aside>

    <GoogleAnalytics />
    <slot />

    <!-- Footer with company legal info -->
    <Footer locale={locale} />

    <script is:inline>
      (function () {
        // ── Theme & fire state ──────────────────────────────
        function updateAll() {
          var isDark = document.documentElement.classList.contains('dark');
          var fireOff = document.documentElement.classList.contains('no-fire');

          document.querySelectorAll('.theme-icon').forEach(function (el) {
            el.textContent = isDark ? '☀️' : '🌙';
          });
          document.querySelectorAll('.theme-label').forEach(function (el) {
            el.textContent = isDark ? 'Light mode' : 'Dark mode';
          });
          document.querySelectorAll('.fire-icon').forEach(function (el) {
            el.textContent = fireOff ? '○' : '🔥';
          });
          document.querySelectorAll('[data-action="toggle-fire"]').forEach(function (btn) {
            btn.setAttribute('aria-label', fireOff ? 'Enable background animation' : 'Disable background animation');
          });
        }

        updateAll();

        document.querySelectorAll('[data-action="toggle-theme"]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var isDark = document.documentElement.classList.contains('dark');
            var next = isDark ? 'light' : 'dark';
            document.documentElement.classList.remove('dark', 'light');
            document.documentElement.classList.add(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
            updateAll();

            // play a short click sound
            try {
              // @ts-ignore - webkitAudioContext is not in standard TS types
              var AudioCtx = window.AudioContext || window.webkitAudioContext;
              var ctx = new AudioCtx();
              var osc = ctx.createOscillator();
              var gain = ctx.createGain();
              osc.type = 'sine';
              osc.frequency.value = next === 'dark' ? 220 : 440;
              gain.gain.value = 0.15;
              gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);
              osc.connect(gain).connect(ctx.destination);
              osc.start();
              osc.stop(ctx.currentTime + 0.15);
            } catch (e) {}
          });
        });

        document.querySelectorAll('[data-action="toggle-fire"]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var off = document.documentElement.classList.contains('no-fire');
            if (off) {
              document.documentElement.classList.remove('no-fire');
              try { localStorage.setItem('fire-disabled', 'false'); } catch (e) {}
            } else {
              document.documentElement.classList.add('no-fire');
              try { localStorage.setItem('fire-disabled', 'true'); } catch (e) {}
            }
            updateAll();
          });
        });

        // ── Mobile sidebar ──────────────────────────────────
        var openBtn = document.getElementById('menu-open');
        var closeBtn = document.getElementById('menu-close');
        var sidebar = document.getElementById('mobile-sidebar');
        var overlay = document.getElementById('sidebar-overlay');

        function openSidebar() {
          sidebar.classList.remove('translate-x-full');
          overlay.classList.remove('hidden');
          openBtn.setAttribute('aria-expanded', 'true');
          closeBtn.focus();
        }
        function closeSidebar() {
          sidebar.classList.add('translate-x-full');
          overlay.classList.add('hidden');
          openBtn.setAttribute('aria-expanded', 'false');
          openBtn.focus();
        }

        if (openBtn) openBtn.addEventListener('click', openSidebar);
        if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !sidebar.classList.contains('translate-x-full')) {
            closeSidebar();
          }
        });

        // Focus trap inside sidebar
        if (sidebar) {
          sidebar.addEventListener('keydown', function (e) {
            if (e.key !== 'Tab') return;
            var focusable = Array.from(sidebar.querySelectorAll('a, button, [tabindex]:not([tabindex="-1"])'));
            var first = focusable[0];
            var last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault(); last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault(); first.focus();
            }
          });
        }
      })();
    </script>
  </body>
</html>
