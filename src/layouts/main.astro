---
import "@/styles/global.css"
import { getLocaleFromURL, useTranslations } from "@/i18n/utils"
import LanguageSwitcher from "@/components/LanguageSwitcher.astro"
import SEO from "@/components/SEO.astro"
import GoogleAnalytics from "@/components/GoogleAnalytics.astro"

const locale = getLocaleFromURL(Astro.url, Astro.request)
const { t } = useTranslations(locale)
---

<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO locale={locale} />
  </head>
  <body>
    <div class="heat-distortion fire"></div>
    <div class="fixed top-4 left-4 z-50">
      <a
        href="/rankings"
        class="px-2.5 py-1 text-xs rounded-md bg-zinc-900/90 text-orange-400/80 border border-orange-500/20 hover:border-orange-400/50 hover:text-orange-300 transition-colors backdrop-blur-sm"
      >
        🔥 Rankings
      </a>
    </div>
    <LanguageSwitcher />
    <GoogleAnalytics />
    <slot />
    <div class="fixed bottom-4 right-4 z-50">
      <a
        href="https://vicedominisoftworks.com"
        target="_blank"
        rel="noopener noreferrer"
        class="block rounded-lg bg-zinc-900/90 backdrop-blur-sm border border-orange-500/30 px-4 py-2 text-sm text-orange-400/90 shadow-lg hover:bg-zinc-800/90 hover:border-orange-400/50 transition-all duration-200"
        set:html={t("site.footer")}
      />
    </div>
  </body>
</html>
