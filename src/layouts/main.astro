---
import "@/styles/global.css"
import { getLocaleFromURL, useTranslations, locales } from "@/i18n/utils"
import LanguageSwitcher from "@/components/LanguageSwitcher.astro"
import SEO from "@/components/SEO.astro"
import GoogleAnalytics from "@/components/GoogleAnalytics.astro"
import Footer from "@/components/Footer.astro"

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props
const locale = getLocaleFromURL(Astro.url, Astro.request)
const { t } = useTranslations(locale)

const currentPath = Astro.url.pathname
function getLocalizedPath(loc: string) {
  const parts = currentPath.split("/").filter(Boolean)
  if (locales.includes(parts[0] as any)) parts[0] = loc
  else parts.unshift(loc)
  return "/" + parts.join("/")
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO locale={locale} title={title} description={description} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.classList.add(theme);
        const fireEnabled = localStorage.getItem('fire-enabled') === 'true';
        if (!fireEnabled) {
          document.documentElement.classList.add('no-fire');
        }
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <div class="heat-distortion fire"></div>

    <header>
      <!-- ── Desktop top-left nav ── -->
    <nav aria-label="Main navigation" class="hidden md:flex fixed top-4 left-4 z-50 items-center gap-2">
      <a href={`/${locale}/rankings`} class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-zinc-900/90 text-orange-400 border border-orange-500/25 hover:border-orange-400/50 hover:text-orange-300 hover:shadow-[0_0_12px_oklch(0.837_0.128_66.29_/_0.3)] transition-all backdrop-blur-sm">{t("rankings.navLink")}</a>
      <a href={`/${locale}/about`}    class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-zinc-900/90 text-orange-400 border border-orange-500/25 hover:border-orange-400/50 hover:text-orange-300 hover:shadow-[0_0_12px_oklch(0.837_0.128_66.29_/_0.3)] transition-all backdrop-blur-sm">{t("nav.about")}</a>
      <a href={`/${locale}/how-it-works`} class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-zinc-900/90 text-orange-400 border border-orange-500/25 hover:border-orange-400/50 hover:text-orange-300 hover:shadow-[0_0_12px_oklch(0.837_0.128_66.29_/_0.3)] transition-all backdrop-blur-sm">{t("nav.howItWorks")}</a>
    </nav>

    <!-- ── Desktop top-right controls ── -->
    <nav aria-label="Settings" class="hidden md:flex fixed top-4 right-4 z-50 items-center gap-2">
      <button data-action="toggle-theme" aria-label="Toggle theme" class="p-2 rounded-lg bg-zinc-900/90 border border-orange-500/25 hover:border-orange-400/50 text-orange-400 hover:text-orange-300 hover:shadow-[0_0_12px_oklch(0.837_0.128_66.29_/_0.3)] hover:scale-105 active:scale-95 transition-all backdrop-blur-sm">
        <span class="theme-icon text-base">☀️</span>
      </button>
      <button data-action="toggle-fire" aria-label="Disable background animation" class="p-2 rounded-lg bg-zinc-900/90 border border-orange-500/25 hover:border-orange-400/50 text-orange-400 hover:text-orange-300 hover:shadow-[0_0_12px_oklch(0.837_0.128_66.29_/_0.3)] hover:scale-105 active:scale-95 transition-all backdrop-blur-sm">
        <span class="fire-icon text-base">🔥</span>
      </button>
      <LanguageSwitcher />
    </nav>

<!-- ── Mobile hamburger ── -->
    <div class="md:hidden fixed top-4 right-4 z-50">
      <button id="menu-open" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-sidebar" class="flex items-center justify-center w-10 h-10 rounded-lg bg-zinc-900/90 border border-orange-500/25 hover:border-orange-400/50 hover:text-orange-300 hover:shadow-[0_0_12px_oklch(0.837_0.128_66.29_/_0.3)] hover:scale-105 active:scale-95 transition-all backdrop-blur-sm">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- ── Mobile sidebar overlay ── -->
    <div id="sidebar-overlay" class="md:hidden fixed inset-0 z-40 bg-black/70 backdrop-blur-[3px] hidden" aria-hidden="true"></div>

    <!-- ── Mobile sidebar ── -->
    <aside
      id="mobile-sidebar"
      role="dialog"
      aria-modal="true"
      aria-label="Menu"
      class="md:hidden fixed top-0 right-0 bottom-0 z-50 w-72 flex flex-col bg-zinc-950/98 border-l border-orange-500/25 backdrop-blur-md shadow-2xl translate-x-full transition-transform duration-200 ease-out"
    >
      <!-- Header -->
      <div class="flex items-center justify-between px-5 pt-5 pb-3.5 border-b border-orange-500/15">
        <span class="text-xs font-bold text-orange-400/60 uppercase tracking-widest">Menu</span>
        <button id="menu-close" aria-label="Close menu" class="flex items-center justify-center w-9 h-9 rounded-lg text-orange-400/60 hover:text-orange-300 hover:bg-orange-500/10 transition-all">
          <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <!-- Nav links -->
      <nav aria-label="Mobile menu" class="flex flex-col gap-1.5 px-4 pt-4">
        <a href={`/${locale}/rankings`}    class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm text-orange-400 hover:text-orange-300 hover:bg-orange-500/10 transition-all font-medium">{t("rankings.navLink")}</a>
        <a href={`/${locale}/about`}       class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm text-orange-400 hover:text-orange-300 hover:bg-orange-500/10 transition-all font-medium">{t("nav.about")}</a>
        <a href={`/${locale}/how-it-works`} class="flex items-center gap-3 px-3.5 py-3 rounded-lg text-sm text-orange-400 hover:text-orange-300 hover:bg-orange-500/10 transition-all font-medium">{t("nav.howItWorks")}</a>
      </nav>

      <!-- Divider -->
      <div class="mx-4 my-4 border-t border-orange-500/15"></div>

      <!-- Theme + Fire toggles -->
      <div class="flex flex-col gap-1.5 px-4">
        <button data-action="toggle-theme" aria-label="Toggle theme" class="flex items-center justify-between px-3.5 py-3 rounded-lg text-sm text-orange-400 hover:text-orange-300 hover:bg-orange-500/10 transition-all w-full text-left font-medium">
          <span class="theme-label">Theme</span>
          <span class="theme-icon text-lg">☀️</span>
        </button>
        <button data-action="toggle-fire" aria-label="Disable background animation" class="flex items-center justify-between px-3.5 py-3 rounded-lg text-sm text-orange-400 hover:text-orange-300 hover:bg-orange-500/10 transition-all w-full text-left font-medium">
          <span>Animation</span>
          <span class="fire-icon text-lg">🔥</span>
        </button>
      </div>

      <!-- Divider -->
      <div class="mx-4 my-4 border-t border-orange-500/15"></div>

      <!-- Language grid -->
      <div class="px-4 pb-4">
        <p class="text-xs text-orange-400/40 uppercase tracking-widest mb-3 px-1 font-bold">Language</p>
        <div class="grid grid-cols-3 gap-2">
          {locales.map((loc) => (
            <a
              href={getLocalizedPath(loc)}
              aria-label={`Switch to ${loc.toUpperCase()}`}
              class={`flex items-center justify-center py-2.5 rounded-lg text-xs font-semibold transition-all border ${
                locale === loc
                  ? "bg-orange-500/20 text-orange-400 border-orange-500/40 shadow-[0_0_10px_oklch(0.837_0.128_66.29_/_0.2)]"
                  : "text-zinc-500 hover:text-orange-300 hover:bg-orange-500/10 border-transparent"
              }`}
            >
              {loc.toUpperCase()}
            </a>
          ))}
        </div>
      </div>
    </aside>
    </header>

    <GoogleAnalytics />
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer with company legal info -->
    <Footer locale={locale} />

    <script>
        try {
          const theme = localStorage.getItem('theme') || 'dark';
          document.documentElement.classList.add(theme);
          const fireEnabled = localStorage.getItem('fire-enabled') === 'true';
          if (fireEnabled) {
            document.documentElement.classList.add('fire-enabled');
          } else {
            document.documentElement.classList.add('no-fire');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.add('no-fire');
        }

        // Mobile menu functionality
        const menuOpenBtn = document.getElementById('menu-open');
        const menuCloseBtn = document.getElementById('menu-close');
        const mobileSidebar = document.getElementById('mobile-sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');

        function openMenu() {
          mobileSidebar?.classList.remove('translate-x-full');
          sidebarOverlay?.classList.remove('hidden');
          menuOpenBtn?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
          mobileSidebar?.classList.add('translate-x-full');
          sidebarOverlay?.classList.add('hidden');
          menuOpenBtn?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        menuOpenBtn?.addEventListener('click', openMenu);
        menuCloseBtn?.addEventListener('click', closeMenu);
        sidebarOverlay?.addEventListener('click', closeMenu);

        // Theme toggle functionality
        function toggleTheme() {
          const html = document.documentElement;
          const isDark = html.classList.contains('dark');
          if (isDark) {
            html.classList.remove('dark');
            html.classList.add('light');
            localStorage.setItem('theme', 'light');
          } else {
            html.classList.remove('light');
            html.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
          updateThemeIcons();
        }

        // Fire/animation toggle functionality
        function toggleFire() {
          const html = document.documentElement;
          const isEnabled = html.classList.contains('fire-enabled');
          if (isEnabled) {
            html.classList.remove('fire-enabled');
            html.classList.add('no-fire');
            localStorage.setItem('fire-enabled', 'false');
          } else {
            html.classList.remove('no-fire');
            html.classList.add('fire-enabled');
            localStorage.setItem('fire-enabled', 'true');
          }
          updateFireIcons();
        }

        function updateThemeIcons() {
          const isDark = document.documentElement.classList.contains('dark');
          document.querySelectorAll('.theme-icon').forEach(icon => {
            icon.textContent = isDark ? '☀️' : '🌙';
          });
          document.querySelectorAll('.theme-label').forEach(label => {
            label.textContent = isDark ? 'Light' : 'Dark';
          });
        }

        function updateFireIcons() {
          const isEnabled = document.documentElement.classList.contains('fire-enabled');
          document.querySelectorAll('.fire-icon').forEach(icon => {
            icon.textContent = isEnabled ? '🔥' : '❄️';
          });
        }

        // Initialize icons
        updateThemeIcons();
        updateFireIcons();

        // Add event listeners to all toggle buttons
        document.querySelectorAll('[data-action="toggle-theme"]').forEach(btn => {
          btn.addEventListener('click', toggleTheme);
        });
        document.querySelectorAll('[data-action="toggle-fire"]').forEach(btn => {
          btn.addEventListener('click', toggleFire);
        });
    </script>
  </body>
</html>
