---
import "@/styles/global.css"
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Website Roaster 🔥</title>
  </head>
  <body>
    <slot />
    <script>
      function createFireParticle(x, y) {
        const particle = document.createElement('div');
        particle.classList.add('fire-particle');
        const size = Math.random() * 10 + 4;
        particle.style.width = `${size}px`;
        particle.style.height = `${size}px`;
        particle.style.left = x ? `${x}px` : `${Math.random() * 100}vw`;
        particle.style.top = y ? `${y}px` : 'auto';
        particle.style.bottom = y ? 'auto' : `-20px`;
        const duration = Math.random() * 5 + 2;
        particle.style.animationDuration = `${duration}s`;
        const colors = [
          'oklch(0.837 0.128 66.29)',
          'oklch(0.705 0.213 47.604)',
          'oklch(0.646 0.222 41.116)',
          'oklch(0.553 0.195 38.402)',
          'oklch(0.47 0.157 37.304)',
          'oklch(0.704 0.191 22.216)',
        ];
        const color = colors[Math.floor(Math.random() * colors.length)];
        particle.style.background = color;
        particle.style.boxShadow = `0 0 ${size * 2}px ${color}`;
        document.body.appendChild(particle);
        setTimeout(() => particle.remove(), duration * 1000);
      }

      // Ambient fire particles rising
      setInterval(() => createFireParticle(), 50);
      for (let i = 0; i < 30; i++) setTimeout(() => createFireParticle(), i * 30);

      // Fire cursor trail
      let mouseX = 0, mouseY = 0;
      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        if (Math.random() > 0.5) createFireParticle(mouseX, mouseY);
      });

      // Ember explosions on click
      document.addEventListener('click', (e) => {
        for (let i = 0; i < 15; i++) {
          setTimeout(() => {
            const ember = document.createElement('div');
            ember.classList.add('fire-particle');
            const size = Math.random() * 8 + 3;
            ember.style.width = `${size}px`;
            ember.style.height = `${size}px`;
            ember.style.left = `${e.clientX + (Math.random() - 0.5) * 100}px`;
            ember.style.top = `${e.clientY + (Math.random() - 0.5) * 100}px`;
            ember.style.animationDuration = `${Math.random() * 2 + 1}s`;
            const colors = ['oklch(0.837 0.128 66.29)', 'oklch(0.705 0.213 47.604)', 'oklch(0.646 0.222 41.116)'];
            ember.style.background = colors[Math.floor(Math.random() * colors.length)];
            ember.style.boxShadow = `0 0 ${size * 3}px ${ember.style.background}`;
            document.body.appendChild(ember);
            setTimeout(() => ember.remove(), 2000);
          }, i * 30);
        }
      });
    </script>
  </body>
</html>
