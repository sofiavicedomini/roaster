---
export const prerender = false;
import Layout from "@/layouts/main.astro";
import { getRanking } from "@/lib/redis";
import { locales, useTranslations, type Locale } from "@/i18n/utils";

const { lang, uuid } = Astro.params;
if (!lang || !locales.includes(lang as Locale)) {
  return Astro.redirect("/it/rankings");
}
if (!uuid) return Astro.redirect(`/${lang}/rankings`);

const { t } = useTranslations(lang as Locale);
const ranking = await getRanking(uuid);
if (!ranking) return Astro.redirect(`/${lang}/rankings`);

const result = ranking.result as {
  overall_score: number;
  verdict: string;
  scores: Record<string, number | null>;
  roasts: Array<{ category: string; emoji: string; critique: string; fix_prompt?: string }>;
};

Astro.response.headers.set("Link", 
  '</.well-known/mcp.json>; rel="mcp", </.well-known/agent.json>; rel="agent-card", </.well-known/openapi.json>; rel="service-desc", </.well-known/api-catalog>; rel="api-catalog"'
);
Astro.response.headers.set("X-Content-Signals", "agent-readable=true");
Astro.response.headers.set("X-MCP-Endpoint", "https://stroncami.it/api/mcp");

const accept = Astro.request.headers.get("accept") || "";
const isAgentRequest = accept.includes("application/json") || 
                       accept.includes("application/vnd.api+json") ||
                       accept.includes("text/markdown") ||
                       accept.includes("text/plain") ||
                       Astro.request.headers.get("x-agent") === "true" ||
                       Astro.request.headers.get("user-agent")?.includes("GPTBot") ||
                       Astro.request.headers.get("user-agent")?.includes("CCBot") ||
                       Astro.request.headers.get("user-agent")?.includes("Google-Extended");

if (isAgentRequest && (accept.includes("application/json") || accept.includes("application/vnd.api+json"))) {
  Astro.response.headers.set("Content-Type", "application/json; charset=utf-8");
  return new Response(JSON.stringify({
    uuid: ranking.uuid, url: ranking.url, normUrl: ranking.normUrl,
    score: result.overall_score, verdict: result.verdict,
    scores: result.scores, roasts: result.roasts,
    completedAt: ranking.completedAt, locale: ranking.locale,
    agentMetadata: {
      version: "1.0.0",
      format: "roast-me/v1",
      mcpEndpoint: "https://stroncami.it/api/mcp",
      documentation: "https://stroncami.it/.well-known/openapi.json"
    }
  }), { headers: { "Vary": "Accept, X-Agent, User-Agent" } });
}
if (isAgentRequest && (accept.includes("text/markdown") || (accept.includes("text/plain") && !accept.includes("text/html")))) {
  const fires = "🔥".repeat(Math.ceil(result.overall_score / 2));
  const roastLines = (result.roasts || []).map((r) =>
    `### ${r.emoji} ${r.category}\n${r.critique}${r.fix_prompt ? `\n\n**Fix prompt:**\n\`\`\`\n${r.fix_prompt}\n\`\`\`` : ""}`
  ).join("\n\n");
  const md = `# ${ranking.normUrl || ranking.url}\n\n**Score:** ${result.overall_score}/10 ${fires}\n\n**Verdict:** ${result.verdict}\n\n---\n\n${roastLines}`;
  return new Response(md, { headers: { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept, X-Agent, User-Agent" } });
}

function scoreColor(score: number | null) {
  if (score === null) return "text-muted-foreground";
  if (score >= 8) return "text-green-500";
  if (score >= 5) return "text-yellow-500";
  return "text-red-500";
}

// Use category label from translations if available, fallback to raw key
function catLabel(cat: string): string {
  const key = `chatbot.categories.${cat}`;
  const translated = t(key);
  return translated === key ? cat : translated;
}

Astro.response.headers.set("Vary", "Accept");
---

<Layout title={`${ranking.normUrl || ranking.url} — ${result.overall_score}/10`} description={result.verdict}>
  <div class="flex min-h-svh flex-col items-center p-6 pt-20 pb-20 md:pt-10 md:pb-10">
    <div class="w-full max-w-2xl">
      <a
        href={`/${lang}/rankings`}
        class="text-sm text-orange-400/60 hover:text-orange-300 mb-6 inline-flex items-center gap-1 transition-colors"
      >
        {t("rankings.backLink")}
      </a>

      <div class="rounded-lg border bg-card p-6 inferno-card flex flex-col gap-5">

        <!-- Header -->
        <div>
          <h1 class="text-lg font-bold break-all leading-snug">{ranking.normUrl || ranking.url}</h1>
          <div class="text-xs text-muted-foreground/60 mt-1.5 flex gap-2 flex-wrap">
            <span>{t("rankings.analyzedOn")} {new Date(ranking.completedAt).toLocaleString(lang, { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" })}</span>
            <span>·</span>
            <span class="uppercase">{ranking.locale}</span>
            <span>·</span>
            <span>{ranking.cats?.length ?? 0} {t("rankings.categories")}</span>
          </div>
        </div>

        <!-- Score -->
        <div class="flex items-center gap-4 p-4 rounded-lg bg-muted/30 border border-orange-500/10">
          <div class={`text-5xl font-bold tabular-nums leading-none ${scoreColor(result.overall_score)}`}>
            {result.overall_score}
            <span class="text-xl font-normal text-muted-foreground">/10</span>
          </div>
          <div class="flex-1">
            <p class="font-medium leading-snug">{result.verdict}</p>
            <p class="text-orange-400 mt-1.5 text-lg">
              {"🔥".repeat(Math.ceil(result.overall_score / 2))}
            </p>
          </div>
        </div>

        <!-- Scores grid -->
        <div class="border-t border-border/50 pt-4">
          <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">{t("rankings.scoresTitle")}</h3>
          <div class="flex flex-wrap gap-2">
            {Object.entries(result.scores || {}).map(([cat, score]) => (
              <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-muted text-sm">
                <span class="capitalize">{catLabel(cat)}</span>
                <span class={`font-bold ${scoreColor(score)}`}>{score !== null ? score : "—"}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Roasts -->
        <div class="border-t border-border/50 pt-4 flex flex-col gap-3">
          <h3 class="font-medium text-lg">{t("rankings.roastsTitle")}</h3>
          {(result.roasts || []).map((roast) => (
            <div class="flex flex-col gap-2 p-3 rounded-lg bg-muted/50">
              <div class="flex gap-3">
                <span class="text-2xl shrink-0">{roast.emoji}</span>
                <div class="flex-1">
                  <h4 class="font-medium capitalize">{catLabel(roast.category)}</h4>
                  <p class="text-sm text-muted-foreground mt-1 leading-relaxed">{roast.critique}</p>
                </div>
              </div>
              {roast.fix_prompt && (
                <div class="ml-11 mt-1 p-3 rounded-md bg-background border border-orange-500/20">
                  <p class="text-xs text-muted-foreground mb-1">{t("rankings.fixPromptLabel")}</p>
                  <code class="text-xs text-orange-400 break-all block whitespace-pre-wrap font-mono">{roast.fix_prompt}</code>
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Footer CTA -->
        <div class="border-t border-border/50 pt-4 text-center">
          <a
            href={`/${lang}`}
            class="inline-block text-sm text-orange-400 hover:text-orange-300 transition-colors"
          >
            {t("rankings.roastYourSiteCta")}
          </a>
        </div>

      </div>
    </div>
  </div>
</Layout>
