---
export const prerender = false;
import Layout from "@/layouts/main.astro";
import { getRankings } from "@/lib/redis";
import { locales, useTranslations, type Locale } from "@/i18n/utils";

const { lang } = Astro.params;
if (!lang || !locales.includes(lang as Locale)) {
  return Astro.redirect("/it/rankings");
}

const { t } = useTranslations(lang as Locale);
const rawRankings = await getRankings(50);
const rankings = rawRankings.filter(Boolean) as NonNullable<typeof rawRankings[number]>[];
const avgScore = rankings.length > 0
  ? (rankings.reduce((s, r) => s + r.score, 0) / rankings.length).toFixed(1)
  : "–";
const statsText = t("rankings.stats")
  .replace("{count}", String(rankings.length))
  .replace("{avg}", String(avgScore));

function scoreColor(score: number) {
  if (score >= 8) return "text-green-500";
  if (score >= 5) return "text-yellow-500";
  return "text-red-500";
}

function scoreFlames(score: number) {
  return "🔥".repeat(Math.max(1, Math.ceil(score / 2)));
}
---

<Layout>
  <div class="flex min-h-svh flex-col items-center p-6 pt-20 pb-20 md:pt-10 md:pb-10">
    <div class="w-full max-w-4xl">
      <div class="mb-8 text-center">
        <a
          href={`/${lang}`}
          class="inline-flex items-center gap-1 text-sm text-orange-400/60 hover:text-orange-300 transition-colors mb-4"
        >
          ← {t("rankings.homeLink")}
        </a>
        <h1 class="text-4xl font-bold inferno-text">{t("rankings.title")}</h1>
        <p class="text-orange-400/80 mt-3 text-base">{t("rankings.subtitle")}</p>
        {rankings.length > 0 && (
          <p class="text-xs text-muted-foreground/50 mt-2">{statsText}</p>
        )}
      </div>

      <div class="mb-10 rounded-lg border border-orange-500/15 bg-card/40 p-5 text-center">
        <p class="text-sm font-medium text-orange-400/80 mb-3">🔥 {t("newsletter.description")}</p>
        <form id="newsletter-form" class="flex gap-2 max-w-sm mx-auto">
          <input
            type="email"
            name="email"
            placeholder={t("newsletter.placeholder")}
            aria-label={t("newsletter.placeholder")}
            required
            class="flex-1 h-9 rounded-md border border-input bg-background px-3 py-1.5 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          />
          <button
            type="submit"
            class="px-4 py-1.5 text-sm rounded-md bg-zinc-900/90 border border-orange-500/30 text-orange-400 hover:bg-zinc-800/90 hover:border-orange-400/50 transition-colors backdrop-blur-sm shrink-0"
          >
            {t("newsletter.submit")}
          </button>
        </form>
        <p id="newsletter-msg" class="text-xs mt-2 hidden" aria-live="polite" aria-atomic="true"></p>
      </div>

      {rankings.length === 0 ? (
        <div class="text-center text-muted-foreground py-20 rounded-lg border border-dashed border-orange-500/20">
          <p class="text-4xl mb-4">🔥</p>
          <p class="text-lg font-medium">{t("rankings.noRoasts")}</p>
          <p class="text-sm mt-2 opacity-60">{t("rankings.noRoastsSubtitle")}</p>
          <a href={`/${lang}`} class="mt-6 inline-block text-sm text-orange-400 hover:text-orange-300 underline">
            {t("rankings.roastSiteCta")}
          </a>
        </div>
      ) : (
        <div class="flex flex-col gap-3">
          {rankings.map((r) => (
            <a
              href={`/${lang}/rankings/${r.uuid}`}
              aria-label={`View roast for ${r.normUrl || r.url}, score ${r.score}/10`}
              class="group rounded-lg border bg-card p-4 hover:bg-muted/10 transition-colors inferno-card flex items-start gap-4 no-underline"
            >
              <div class={`text-2xl font-bold tabular-nums shrink-0 leading-none mt-0.5 ${scoreColor(r.score)}`}>
                {r.score}<span class="text-sm font-normal opacity-60">/10</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm text-foreground truncate">{r.normUrl || r.url}</div>
                <div class="text-sm text-muted-foreground mt-1 line-clamp-2 leading-snug">{r.verdict}</div>
                <div class="flex items-center gap-3 mt-2 text-xs text-muted-foreground/50">
                  <span>{new Date(r.completedAt).toLocaleDateString(lang, { day: "2-digit", month: "short", year: "numeric" })}</span>
                  <span>·</span>
                  <span>{r.cats?.length ?? 0} {t("rankings.categories")}</span>
                  <span>·</span>
                  <span class="uppercase">{r.locale}</span>
                </div>
              </div>
              <div class="shrink-0 text-xl leading-none mt-0.5" title={`Score: ${r.score}/10`}>
                {scoreFlames(r.score)}
              </div>
            </a>
          ))}
        </div>
      )}

    </div>
  </div>
</Layout>

<script is:inline define:vars={{ successMsg: t("newsletter.success"), errorMsg: t("newsletter.error") }}>
  const form = document.getElementById("newsletter-form");
  const msg = document.getElementById("newsletter-msg");
  if (form && msg) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = new FormData(form).get("email");
      try {
        const res = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        msg.textContent = res.ok ? successMsg : errorMsg;
        msg.className = `text-xs mt-2 ${res.ok ? "text-green-400" : "text-red-400"}`;
        if (res.ok) form.reset();
      } catch {
        msg.textContent = errorMsg;
        msg.className = "text-xs mt-2 text-red-400";
      }
    });
  }
</script>
