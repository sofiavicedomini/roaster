---
export const prerender = false;
import Layout from "@/layouts/main.astro";
import { locales, useTranslations, type Locale } from "@/i18n/utils";

const { lang } = Astro.params;
if (!lang || !locales.includes(lang as Locale)) {
  return Astro.redirect("/it/how-it-works");
}

const { t } = useTranslations(lang as Locale);

const steps = [
  { title: t("howItWorks.step1Title"), desc: t("howItWorks.step1Desc"), num: "01" },
  { title: t("howItWorks.step2Title"), desc: t("howItWorks.step2Desc"), num: "02" },
  { title: t("howItWorks.step3Title"), desc: t("howItWorks.step3Desc"), num: "03" },
  { title: t("howItWorks.step4Title"), desc: t("howItWorks.step4Desc"), num: "04" },
];
---

<Layout title={t("howItWorks.title")} description={t("howItWorks.intro")}>
  <div class="flex min-h-svh flex-col items-center p-6 pt-20 pb-20 md:pt-10 md:pb-10">
    <div class="w-full max-w-2xl">
      <div class="mb-8">
        <a
          href={`/${lang}`}
          class="inline-flex items-center gap-1 text-sm text-orange-400/60 hover:text-orange-300 transition-colors mb-4"
        >
          ← {t("rankings.homeLink")}
        </a>
        <h1 class="text-4xl font-bold inferno-text">{t("howItWorks.title")}</h1>
        <p class="text-orange-400/80 mt-2 text-base">{t("howItWorks.subtitle")}</p>
      </div>

      <div class="flex flex-col gap-4 mb-8">
        {steps.map((step) => (
          <div class="rounded-lg border bg-card p-5 inferno-card flex gap-4">
            <div class="shrink-0 text-2xl font-black text-orange-500/30 tabular-nums leading-none mt-0.5">{step.num}</div>
            <div>
              <h3 class="font-semibold text-foreground">{step.title}</h3>
              <p class="text-muted-foreground text-sm mt-1 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a
          href={`/${lang}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-orange-500/10 border border-orange-500/30 text-orange-400 hover:bg-orange-500/20 hover:border-orange-400/50 transition-colors font-medium text-lg"
        >
          🔥 {t("howItWorks.cta")}
        </a>
      </div>
    </div>
  </div>
</Layout>
