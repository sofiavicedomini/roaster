---
import Layout from "@/layouts/main.astro"
import { Chatbot } from "@/components/chatbot"
import { useTranslations, locales, type Locale } from "@/i18n/utils"

const langParam = Astro.params.lang as string
const locale: Locale = locales.includes(langParam as Locale) ? langParam as Locale : "en"

if (!locales.includes(langParam as Locale)) {
  return Astro.redirect("/")
}

const { t } = useTranslations(locale)
---

<Layout>
  <div class="flex min-h-svh flex-col items-center justify-center p-6">
    <div class="w-full max-w-2xl">
      <div class="mb-8 text-center">
        <h1 class="text-6xl font-bold inferno-text">
          {t("site.title")}
        </h1>
        <p class="text-orange-400/90 mt-3 text-lg animate-pulse">🔥 {t("site.description")} 🔥</p>
      </div>
      <Chatbot client:only="react" locale={locale} />
    </div>
  </div>
</Layout>
