---
import { useTranslations, type Locale } from "@/i18n/utils"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { t } = useTranslations(locale)

const categories = [
  { id: "design", group: "technical" },
  { id: "performance", group: "technical" },
  { id: "code", group: "technical" },
  { id: "mobile", group: "technical" },
  { id: "ux", group: "experience" },
  { id: "accessibility", group: "experience" },
  { id: "conversion", group: "experience" },
  { id: "seo", group: "content" },
  { id: "copy", group: "content" },
  { id: "brand", group: "trust" },
  { id: "credibility", group: "trust" },
  { id: "security", group: "trust" },
  { id: "agentReadiness", group: "aiAgents" },
  { id: "robots", group: "aiAgents" },
  { id: "mcp", group: "aiAgents" },
  { id: "apiDiscovery", group: "aiAgents" },
  { id: "botAuth", group: "aiAgents" },
]

const defaultCategories = ["design", "performance", "ux", "seo", "agentReadiness"]

const groups = categories.reduce((acc, cat) => {
  if (!acc[cat.group]) acc[cat.group] = []
  acc[cat.group].push(cat)
  return acc
}, {} as Record<string, typeof categories>)
---

<form
  id="chatbot-form"
  class="flex flex-col gap-5 rounded-xl border border-orange-500/15 p-5 bg-gradient-to-br from-background to-orange-500/5 shadow-lg"
  aria-label={t("chatbot.urlLabel")}
>
  <div class="flex flex-col gap-3">
    <label for="site-url" class="text-sm font-semibold tracking-tight text-orange-200/90">{t("chatbot.urlLabel")}</label>
    <input
      id="site-url"
      type="url"
      required
      placeholder={t("chatbot.urlPlaceholder")}
      class="w-full rounded-lg border border-orange-500/20 bg-background/80 px-4 py-3 text-sm placeholder:text-orange-300/40 focus:outline-none focus:ring-2 focus:ring-orange-500/40 transition-all"
    />
    {t("chatbot.urlHint") && (
      <p class="text-xs text-orange-300/50 mt-0.5">{t("chatbot.urlHint")}</p>
    )}
  </div>

  <div class="flex flex-col gap-3">
    <label class="text-sm font-semibold tracking-tight text-orange-200/90">{t("chatbot.categoriesLabel")}</label>

    <div class="md:hidden">
      <button
        type="button"
        id="category-dropdown-toggle"
        class="w-full flex items-center justify-between px-4 py-3 rounded-lg border border-orange-500/20 bg-orange-500/5 text-sm font-medium text-orange-200 hover:bg-orange-500/10 transition-all"
      >
        <span id="category-count">{defaultCategories.length} selected</span>
        <svg class="w-5 h-5 text-orange-400/60 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div id="category-dropdown" class="hidden mt-2 p-3 rounded-lg border border-orange-500/20 bg-zinc-900/95 shadow-xl max-h-80 overflow-y-auto">
        <div class="grid grid-cols-2 gap-2">
          {categories.map((cat) => (
            <label class="flex items-center gap-3 p-3 rounded-lg cursor-pointer hover:bg-orange-500/10 transition-all min-h-[48px] border border-transparent hover:border-orange-500/15">
              <input
                type="checkbox"
                name="categories"
                value={cat.id}
                checked={defaultCategories.includes(cat.id)}
                class="w-5 h-5 rounded border-orange-500/30 accent-orange-500 bg-orange-500/10"
              />
              <span class="text-sm font-medium text-orange-200">
                {(t(`chatbot.categories.${cat.id}`) as string) || cat.id}
              </span>
            </label>
          ))}
        </div>
      </div>
    </div>

    <div class="hidden md:flex flex-col gap-3">
      {Object.entries(groups).map(([group, cats]) => (
        <div class="flex flex-col gap-2">
          <span class="text-[0.65rem] font-bold text-orange-300/50 uppercase tracking-widest">
            {(t(`chatbot.groups.${group}`) as string) || group}
          </span>
          <div class="flex flex-wrap gap-2">
            {cats.map((cat) => (
              <label class={`flex items-center gap-2 px-3.5 py-2 rounded-lg border cursor-pointer transition-all duration-200 text-sm ${
                defaultCategories.includes(cat.id)
                  ? "border-orange-500/50 bg-orange-500/20 shadow-[0_0_16px_oklch(0.837_0.128_66.29_/_0.3)] scale-[1.02] text-orange-100"
                  : "border-orange-500/15 bg-orange-500/5 hover:bg-orange-500/10 hover:border-orange-500/25 hover:shadow-[0_0_8px_oklch(0.705_0.213_47.604_/_0.2)] hover:scale-[1.01] text-orange-200/60"
              }`}>
                <input
                  type="checkbox"
                  name="categories"
                  value={cat.id}
                  checked={defaultCategories.includes(cat.id)}
                  class="sr-only"
                />
                <span class="font-medium">
                  {(t(`chatbot.categories.${cat.id}`) as string) || cat.id}
                </span>
                <svg class={`w-4 h-4 transition-all duration-200 ${
                  defaultCategories.includes(cat.id)
                    ? "text-orange-400 scale-100"
                    : "text-orange-300/30 scale-75"
                }`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </label>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div id="turnstile-container" class="flex justify-center min-h-[70px]"></div>

  <div id="captcha-status" class="hidden text-center text-xs text-amber-300/90 font-medium" role="status" aria-live="polite">
    ↻ {t("chatbot.verifyingRobot")}
  </div>

  <button
    type="submit"
    id="roast-submit"
    class="inline-flex items-center justify-center whitespace-nowrap rounded-xl text-sm font-semibold transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500/40 disabled:pointer-events-none disabled:opacity-50 bg-gradient-to-br from-orange-500 to-orange-600 text-white shadow-lg hover:from-orange-400 hover:to-orange-500 hover:shadow-[0_0_24px_oklch(0.837_0.128_66.29_/_0.5)] hover:scale-[1.02] active:scale-[0.98] h-11 px-6"
  >
    {t("chatbot.buttonRoast")}
  </button>
</form>

<noscript>
  <div class="mt-4 p-4 rounded-lg border bg-amber-500/15 border-amber-500/50 text-amber-300 text-sm">
    <p class="font-medium">JavaScript richiesto</p>
    <p class="mt-1 text-xs text-amber-300/80">Questo form richiede JavaScript per funzionare. Abilita JavaScript nel tuo browser per usare questo servizio.</p>
  </div>
</noscript>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dropdownToggle = document.getElementById("category-dropdown-toggle")
    const dropdown = document.getElementById("category-dropdown")
    const countSpan = document.getElementById("category-count")
    const checkboxes = document.querySelectorAll('#chatbot-form input[name="categories"]')

    if (dropdownToggle && dropdown) {
      dropdownToggle.addEventListener("click", () => {
        dropdown.classList.toggle("hidden")
        dropdownToggle.querySelector("svg")?.classList.toggle("rotate-180")
      })

      checkboxes.forEach(cb => {
        cb.addEventListener("change", () => {
          const checked = document.querySelectorAll('#chatbot-form input[name="categories"]:checked')
          if (countSpan) countSpan.textContent = `${checked.length} selected`
        })
      })

      document.addEventListener("click", (e) => {
        if (!dropdownToggle.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
          dropdown.classList.add("hidden")
          dropdownToggle.querySelector("svg")?.classList.remove("rotate-180")
        }
      })
    }
  })
</script>

<script is:inline>
  document.documentElement.classList.add('js-enabled');
</script>

<style is:global>
  .js-enabled #chatbot-form {
    display: none;
  }
</style>

<noscript>
  <style is:global>
    #chatbot-form {
      display: block !important;
    }
  </style>
</noscript>