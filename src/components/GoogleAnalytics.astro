---
const gtmId = import.meta.env.GTAG_ID || ""
const adSenseId = import.meta.env.ADSENSE_ACCOUNT_ID || ""
const hasGtm = gtmId.length > 0
const hasAdSense = adSenseId.length > 0
---

{(hasGtm || hasAdSense) && (
    <!-- Google Tag Manager with Consent Mode v2 - non-blocking via dynamic load -->
    <script is:inline define:vars={{ gtmId }}>
      (function() {
        // Default consent - denied by default, AdSense/AdSense Privacy & Messaging handles consent
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}

        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'denied',
          'wait_for_update': 500
        });

        // Load GTM asynchronously after page load
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() {
            loadGTM();
          });
        } else {
          loadGTM();
        }

        function loadGTM() {
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
          document.head.appendChild(script);
        }
      })();
    </script>
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0" width="0" style="display:none;visibility:hidden">
      </iframe>
    </noscript>
  </>
)}

{hasAdSense && (
  <>
    <!-- AdSense via GTM -->
    <div id="gtm-nocount" data-scope="default"></div>
  </>
)}
