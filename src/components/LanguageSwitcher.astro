---
import { locales } from "@/i18n/utils"

const currentPath = Astro.url.pathname
const currentLocale = Astro.url.pathname.split("/")[1]

function getLocalizedPath(locale: string) {
  const pathParts = currentPath.split("/").filter(Boolean)
  if (locales.includes(pathParts[0] as any)) {
    pathParts[0] = locale
  } else {
    pathParts.unshift(locale)
  }
  return "/" + pathParts.join("/")
}
---

<div class="relative" id="lang-switcher">
  <button
    id="lang-toggle"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="Select language"
    class="flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-lg bg-zinc-900/90 text-orange-400 border border-orange-500/25 hover:border-orange-400/50 hover:text-orange-300 hover:shadow-[0_0_10px_oklch(0.837_0.128_66.29_/_0.25)] transition-all backdrop-blur-sm font-medium"
  >
    <span id="lang-current">{currentLocale.toUpperCase()}</span>
    <svg id="lang-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform duration-200">
      <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <ul
    id="lang-menu"
    role="listbox"
    aria-label="Language"
    class="absolute right-0 mt-1.5 min-w-[6rem] rounded-lg bg-zinc-900/95 border border-orange-500/25 backdrop-blur-md shadow-xl overflow-hidden hidden"
  >
    {locales.map((locale) => (
      <li role="option" aria-selected={currentLocale === locale}>
        <a
          href={getLocalizedPath(locale)}
          class={`block px-3.5 py-2 text-xs transition-all ${
            currentLocale === locale
              ? "text-orange-400 bg-orange-500/15 font-semibold"
              : "text-zinc-400 hover:text-orange-300 hover:bg-orange-500/10"
          }`}
        >
          {locale.toUpperCase()}
        </a>
      </li>
    ))}
  </ul>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById("lang-toggle");
    var menu = document.getElementById("lang-menu");
    var chevron = document.getElementById("lang-chevron");

    function open() {
      menu.classList.remove("hidden");
      btn.setAttribute("aria-expanded", "true");
      chevron.style.transform = "rotate(180deg)";
    }
    function close() {
      menu.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
      chevron.style.transform = "";
    }

    btn.addEventListener("click", function (e) {
      e.stopPropagation();
      if (menu.classList.contains("hidden")) {
        open();
        var first = menu.querySelector("a");
        if (first) first.focus();
      } else {
        close();
        btn.focus();
      }
    });

    document.addEventListener("click", function () { close(); });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") { close(); btn.focus(); }
    });

    menu.addEventListener("keydown", function (e) {
      var items = Array.from(menu.querySelectorAll("a"));
      var idx = items.indexOf(document.activeElement);
      if (e.key === "ArrowDown") {
        e.preventDefault();
        var next = items[(idx + 1) % items.length];
        if (next) next.focus();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        var prev = items[(idx - 1 + items.length) % items.length];
        if (prev) prev.focus();
      } else if (e.key === "Tab") {
        close();
      }
    });
  })();
</script>
