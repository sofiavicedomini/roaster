---
import { locales } from "@/i18n/utils"

const currentPath = Astro.url.pathname
const currentLocale = Astro.url.pathname.split("/")[1]

function getLocalizedPath(locale: string) {
  const pathParts = currentPath.split("/").filter(Boolean)
  if (locales.includes(pathParts[0] as any)) {
    pathParts[0] = locale
  } else {
    pathParts.unshift(locale)
  }
  return "/" + pathParts.join("/")
}
---

<div class="fixed top-4 right-4 z-50 flex gap-1">
  {locales.map((locale) => (
    <a
      href={getLocalizedPath(locale)}
      class={`px-2 py-1 text-xs rounded-md transition-colors ${
        currentLocale === locale
          ? "bg-orange-500/20 text-orange-400 border border-orange-500/30"
          : "bg-zinc-900/90 text-zinc-400 border border-zinc-700 hover:border-orange-500/30 hover:text-orange-400"
      }`}
    >
      {locale.toUpperCase()}
    </a>
  ))}
</div>
